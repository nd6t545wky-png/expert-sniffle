{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dylan-pitching-os",
  "main": "src/index.ts",
  // NOTE: reconstructed from the deployed bundle — confirm this matches
  // whatever compatibility_date the original project actually used.
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  // Fixes the "ships raw, unminified vendor source" audit finding: the
  // deployed Worker script was never minified. This minifies it at deploy time.
  "minify": true,
  // Per-version preview URLs, so a working branch can be deployed with
  // `wrangler versions upload` and opened on a phone without touching
  // production. Item 8's "preview deployments for development branches".
  "preview_urls": true,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Not "single-page-application": that answers every unknown path with
    // index.html and a 200, so a deploy that dropped a directory served the
    // wrong app instead of failing. The Worker does the fallback itself in
    // `serveAsset`, where a missing *file* can still be a 404.
    "not_found_handling": "none"
  },

  "vars": {
    "APP_ORIGIN": "https://dylan-pitching-os.tourmaline-goldfish.workers.dev"
  },

  "d1_databases": [
    {
      "binding": "SYNC_DB",
      "database_name": "dylan-pitching-os-sync",
      "database_id": "dbf28152-9081-4b6d-a3ec-6753240d92c0"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PRIVATE_MEDIA",
      "bucket_name": "pitching-os-private-media"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "images": {
    "binding": "IMAGES"
  },

  // Workers Rate Limiting. This MUST use the top-level "ratelimits" key —
  // the older "unsafe.bindings" form with type "ratelimit" is accepted at
  // deploy time but registers as opaque "Unsafe Metadata", so limit() always
  // returns success and nothing is rate limited. With the key below, wrangler
  // reports these as real "Rate Limit" bindings instead.
  // simple.period must be either 10 or 60.
  //
  // These limits ARE now active protection, but not because of this binding:
  // the count that can be demonstrated lives in D1, in `overLimit` in
  // src/index.ts. Proven against the deployed Worker — 100 requests fired as a
  // burst at the 60-per-minute ingest endpoint, 51 refused with 429.
  //
  // Whether the binding itself enforces in production remains unproven either
  // way, and the earlier conclusion that it did not was reached from an
  // invalid test. Sequential requests through a proxy took about 1.4 seconds
  // each, so 90 of them spanned more than two 60-second windows and at most
  // ~42 landed in any one — the limit could not have been reached, whatever
  // the binding was doing. Anyone retesting this must fire a parallel burst,
  // not a loop. Cloudflare documents the limiter as permissive, per-colo and
  // eventually consistent, with no dashboard visibility, so there is nothing
  // to inspect from outside.
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "INTEGRATION_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Apple Health ingest. Deliberately generous so a legitimate
      // multi-day backfill from the iPhone Shortcut isn't throttled,
      // while still bounding abuse of the one externally-reachable route.
      "name": "INGEST_RATE_LIMITER",
      "namespace_id": "2003",
      "simple": { "limit": 60, "period": 60 }
    }
  ]

  // Secrets (set with `wrangler secret put <NAME>`, never committed here):
  //   BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  //   OURA_CLIENT_ID, OURA_CLIENT_SECRET, HEALTH_TOKEN_KEY, WORKSPACE_MASTER_KEY
}
