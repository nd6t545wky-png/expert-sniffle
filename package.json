{
  "name": "dylan-pitching-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/workflows.mjs && node e2e/migration.mjs && node e2e/autosave.mjs && node e2e/offline.mjs && node e2e/worker.mjs",
    "e2e:serve": "npm run build && (cd dist && python3 -m http.server 8899 --bind 127.0.0.1)",
    "db:local": "wrangler d1 migrations apply dylan-pitching-os-sync --local"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.23",
    "@mediapipe/tasks-vision": "^1.0.1",
    "better-auth": "1.6.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260714.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^8.2.1",
    "vitest": "^3.2.7",
    "wrangler": "^4.0.0"
  }
}
